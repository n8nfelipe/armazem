  "narrative": {
    "northStar": "The Warehouse Ledger",
    "overview": "Armazém reads as an editorial operations console: restrained cream work surfaces, a forest-green navigation rail, fine rules, and compact records. The hierarchy helps an inventory operator scan quantities, identify exceptions, and act on a specific record. The replenishment screen extends this established language. The interface uses flat surfaces and structured density. Operational measurements, references, dates, and small labels use monospace; titles and explanatory text use the system sans stack. Color marks action and status while the ledger remains mostly neutral.",
    "keyCharacteristics": [
      "Cream workspace with a dark forest navigation rail.",
      "Squared sheets, controls, rows, and status badges separated by fine borders.",
      "Compact tabular records with prominent quantities and restrained supporting copy.",
      "Mobile layouts that reflow records into readable field groups."
    ],
    "rules": [
      { "name": "The Ledger Rule", "body": "Use fine rules and tonal surfaces to organize information; reserve saturated color for action, selection, and status.", "section": "colors" },
      { "name": "The Measurement Rule", "body": "Show operational values in monospace and keep their units or context adjacent.", "section": "typography" }
    ],
    "dos": [
      "Do reuse the cream, forest, border, and type tokens from the global stylesheet.",
      "Do keep quantitative records compact, aligned, and readable on mobile.",
      "Do pair color-coded statuses with visible text."
    ],
    "donts": [
      "Don't introduce rounded cards or controls into the warehouse workspace.",
      "Don't use decorative shadows to organize ordinary sheets and tables.",
      "Don't hide record actions or measurement context when a table reflows."
